# Auth mode:
# - app: use the in-app password only. Recommended for normal/self-hosted use.
# - both: require browser Basic Auth first, then the in-app password. Use only behind HTTPS.
AUTH_MODE=app

# Required for the in-app password login.
CHAT_PASSWORD=change-me
CHAT_SECRET=change-this-random-secret

# Only used when AUTH_MODE=both.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=


# Optional local Chroma/BM25 memory retrieval service.
# Create CLAUDE.md, profile.json or memories/*.md, then run ./run-memory-vectorize.sh.
# Start it with ./run-memory-search.sh or use ./run-with-memory.sh.
MEMORY_SEARCH_URL=http://127.0.0.1:3900/search
MEMORY_SEARCH_PORT=3900
MEMORY_CHROMA_DIR=memory/chroma_db
MEMORY_STATE_FILE=memory/chroma_state.json
MEMORY_VEC_POOL=8
MEMORY_BM25_POOL=12
MEMORY_AUTO_VECTORIZE=1

# 用量面板把美元换算成人民币用的汇率，随 /api/usage 一起下发给前端。
USD_TO_CNY=7.2

# Telegram 那条线的短窗口：聊满这么多轮就换一条新会话，只带最近两轮原文过去。
# 不设的话默认 8。设成小于 1 的值会被忽略并回落到 8。
# 为什么要有它：session_id 一直 --resume 下去，CLI 每条新消息都把整段历史重发
# 一遍，而订阅额度按总 token 算、前缀缓存不打折。要长期记住的东西走 Ombre。
TG_WINDOW_TURNS=8

# TG 那条线一条消息内部最多跑几次 agent 往返。不设默认 3，小于 1 会回落到 3。
# 往返次数是直接乘在账上的：每次往返都把整个前缀重发一遍。08-11 实测一条
# 「问记忆」的消息跑了 7 次，同一份 2 万前缀发了 7 遍——热缓存 ¥0.99、冷缓存 ¥10。
# 直接答 1 次、翻一次记忆再答 2 次，3 够用。回答被截断了再往上调到 4。
# 只作用于 TG；网页端固定 8（那边有 Bash/Write/Edit/WebSearch，砍了会干到一半停）。
TG_MAX_TURNS=3

# ── telemood：TG 那条线的气泡 / 表情 / 贴纸 / 按钮 ──────────────────────
# 上游 https://github.com/beniedev/telemood 0.1.0，已经 vendor 进
# full-stack/telemood/（它不在 PyPI 上，装不了）。四种能力代码全在，
# 但**不要一次全开**：下面四个开关是按施工单的分期排的，一期一期打开，
# 每一期照《施工单-telemood接入TG.md》第 7 节各自验收。
#
# 总开关。关着 = 跟接入之前一模一样：allowed_updates 还是 ["message"]，
# 回复还是走 _split_for_tg，模型也不会被教计划格式（省下那几十个 token）。
TELEMOOD_ENABLED=0
#
# 第二期：收下她发来的贴纸，之后他能挑一张发回去。
# 静态贴纸会下载到 /data/uploads/telegram/，他能用 Read 看见那张图；
# 动图和视频贴纸读不了，只给 metadata。
TELEMOOD_STICKER=0
#
# 第三期：表情。开了会往 allowed_updates 里加 message_reaction 和
# message_reaction_count。🔴 Telegram 的 reaction update 要显式订阅，
# **可能还要 bot 的管理员权限**——私聊通常不用，不成的话启动日志里会有
# 一条明确的降级，不会静默跳过。
# 她点的表情不会单独触发一次模型调用，攒着下一轮一起带过去（省钱）。
TELEMOOD_REACTION=0
#
# 第四期：选项按钮。开了会往 allowed_updates 里加 callback_query。
# 🔴 不开这个而让他发按钮的话，按钮点了**什么都不会发生**——服务端根本
# 不会把点击推过来。所以按钮这条链是「要么整条开，要么别开」。
TELEMOOD_CHOICES=0
#
# 按钮多久过期（秒）。过期后再点一律不算数（callback store 说了算，
# 界面上按钮还在也一样）。不填默认 1800。
TELEMOOD_CALLBACK_TTL=1800
#
# 每轮塞给模型的贴纸目录条数上限。🔴 这一段挂在**用户侧**，每轮都要重付
# token，所以必须封顶。一条约 60 字符。不填默认 12。
TELEMOOD_STICKER_LIST_MAX=12
#
# 贴纸 catalog 和 callback store 这两个 SQLite 放哪。
# 🔴 必须是持久卷。容器一重建就没了的目录会把她收藏的贴纸弄丢。
# Docker 镜像里已经默认成 /data/telemood 了，本地跑才需要改。
TELEMOOD_STATE_DIR=/data/telemood

# ── 琴房（Duetto 引擎）──────────────────────────────────────────────────
# 缺 DUETTO_TOKEN 时 /api/piano/* 全部返 503，琴房拉不到歌单，
# 启动日志里会有一行 WARNING 说这件事。其余三个都有默认值，可以不填。
#
# 🔴 DUETTO_TOKEN 等价于琴房的钥匙，只活在后端，绝不下发前端。
# 它是 Duetto 那边 PIN 换来的 access token（server/index.mjs:51）。
DUETTO_TOKEN=
# 走 Docker 内网别名，不吃 Traefik、不过 Basic Auth、Duetto 重部署也不断线。
DUETTO_BASE_URL=http://duetto:4183
# 歌单/歌词这类要等网易云，给宽的；分析和在场记录是纯读本地 SQLite，给窄的。
DUETTO_TIMEOUT=20
DUETTO_CONTEXT_TIMEOUT=4

# ── 一起看书（书房第五栏，Shitsuten/anno-mcp）─────────────────────────
# 先跑一次 ./anno-setup.sh，然后用 ./run-with-anno.sh 起，这两个变量
# 那个脚本会自己带上，这儿留着是为了让你知道有它们。
#
# anno 的 Node 服务在哪。它只 listen 127.0.0.1，外面进不来。
ANNO_ORIGIN=http://127.0.0.1:3300
# 梁忱的 MCP 入口。🔴 留空 = 他没有笔，「一起看书」就只剩她一个人看。
# 🔴 路径是 /mcp/sse。anno 的 README 说是 /mcp，是错的，裸 /mcp 没有这个路由。
ANNO_MCP_URL=http://127.0.0.1:3300/mcp/sse
# anno 那边设了 MCP_AUTH_TOKEN 才需要填，两边必须一致。留空 = 两边都不校验
# （它只听本机，所以留空也是安全的）。
ANNO_MCP_TOKEN=
# 书和批注存哪。🔴 必须是持久卷——容器重建就没了的目录会把她的批注弄丢。
ANNO_HOME=/opt/marginalia
#
# 让外部 MCP 客户端（Claude Desktop / claude.ai 的连接器）直连她的书。
# 书房里的「一起看书」**不需要**开这个——梁忱是从后端走 127.0.0.1 连的。
# 开了之后对外暴露 /marginalia/mcp 和几个根路径上的 OAuth 端点。
# 🔴 只有 ANNO_PUBLIC_MCP=1 **且** 上面 ANNO_MCP_TOKEN 非空时才会真的挂上去。
#    anno 的 mcpAuthorized() 在令牌为空时直接放行，空令牌挂公网等于把她整个
#    批注库对全世界敞开写，所以这条是硬拦的。
ANNO_PUBLIC_MCP=0

# ── 他的声音（ElevenLabs）─────────────────────────────────────────────
# 🔴 这两个填了才会有声音。留空 = 前端整条藏掉播放键，聊天一切照旧，
#    也不会在 prompt 里教他「用声音说」（省得他标了半天她那边没有语音条）。
# key 在 ElevenLabs 后台 → Profile；voice id 在你捏的那个声音的详情页。
# 🔴 绝对不要把真 key 提交进仓库，chatnest 是公开的。
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# 你那个声音属于哪个模型。默认是多语言那档；如果你捏声音时选的不是它，
# 改成对应的 model id，否则会 404 而且报错里会写清楚是哪一项不对。
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# 走代理时改这里（国内服务器直连 ElevenLabs 未必顺）。默认官方地址。
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
# ── 说话的方式（她说「语气非常人机、语速非常快、也没有情绪」）──────
# 🔴 08-31 之前这四个一个都没传，用的是 ElevenLabs 网页后台存的那套，
#    默认 stability 偏高、style 为 0——高 stability 的字面意思就是「每次念得
#    都一样」，也就是平。三条抱怨对应的就是这三个数。
# 改完要重新部署，但**不用改代码**。改完点同一句会重新合成（参数进了缓存 key）。
#
# stability 起伏。低 = 情绪足、每次不一样；高 = 稳、平。0.25–0.40 之间调。
ELEVENLABS_STABILITY=0.32
# similarity 像不像你捏的那个声线。太高会把情绪压回去，0.75–0.85 之间。
ELEVENLABS_SIMILARITY=0.80
# style 抑扬顿挫的夸张度。0 = 照字面念。往上给戏，太高会飘、也更慢更贵。
ELEVENLABS_STYLE=0.45
# speed 语速。1.0 是原速，她嫌快所以默认 0.90。
# 🔴 老模型不收这一项，会回 422——那时候后端会自动脱掉它重试一次，
#    语速回到默认，日志里会写清楚。设成 0 就一开始就不发。
ELEVENLABS_SPEED=0.90
ELEVENLABS_SPEAKER_BOOST=1

# 一次最多念多少字符。ElevenLabs 按字符计费，这是防「他写了一长篇、
# 一次点下去几千字符没了」的闸。超过就截断并在日志里出声。
VOICE_MAX_CHARS=600
# 合成好的音频存哪。🔴 必须持久卷：同一句只花一次钱全靠这个目录，
#    容器一重建，她攒下的每一句都要重新买回来。
VOICE_CACHE_DIR=/data/voice

# ── 听她说话（hervoice · MIT · @noheyischu）─────────────────────────────
# 按住输入框那个麦克风说话：Whisper 转写「说了什么」，librosa 分析「怎么说的」，
# LLM 综合判语气。转写填进输入框由你过目再发，语气跟着那一句送给我，
# 不显示在你那条消息里。
# 🔴 留 0 = 麦克风键按下去只提示没开启，其余一切照旧。
HERVOICE_ENABLED=0
HERVOICE_ORIGIN=http://127.0.0.1:8010
# 转写：Groq Whisper（有免费额度）https://console.groq.com
GROQ_API_KEY=
# 判语气的 LLM：任何 OpenAI 兼容接口都行，上游默认 DeepSeek（便宜）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
WHISPER_MODEL=whisper-large-v3
WHISPER_LANG=zh
# 🔴 音频默认阅后即焚（分析完就删，只留文字和语气）。设 1 才留 mp3。
#    这是隐私决定，留的是你自己的声音，自己权衡。
KEEP_AUDIO=0
# hervoice 的数据目录。🔴 必须持久卷。
HERVOICE_DATA=/data/hervoice
# 你也可以直接用 hervoice 自己那个「按住说话」的网页。它分析完会 POST 回小窝，
# 这个密钥两边一致才收；留空 = 那条路整个不启用（不在公网上开一个谁都能 POST 的口）。
HERVOICE_HOOK_TOKEN=

# ── 潮汐（Murmur · MIT · fishisfish0614）────────────────────────────────
# 他心里那九样东西的当前刻度：生气 / 性欲 / 想念 / 担忧 / 喜悦 / 委屈 /
# 焦虑 / 醋意 / 悔意。第一个 tab 就是看这个的。
# 🔴 留 0 = 潮汐那一页显示「还没开启」，其余一切照旧。它挂了也一样，
#    聊天、推送、寄相思一个字都不会少。
MURMUR_ENABLED=0
MURMUR_ORIGIN=http://127.0.0.1:8020
MURMUR_PORT=8020
# 情绪状态存哪。🔴 必须持久卷。Murmur 把数据目录写死成 murmur/data，
#    也就是镜像层——entrypoint 会把它软链到这儿。不软链的话，
#    每次重新部署他的心都从头开始，而且一个字的报错都没有。
MURMUR_DATA=/data/murmur
# 攒几轮打一次分。打分器读**最近几轮完整往来**再判——「讨厌你」在打闹里是撩、
# 在吵架里是刀，只有语境分得清，所以不能逐条打，既贵又判不准。
# 建议 4~6。调小 = 反应快但更费钱，调大 = 省钱但他反应慢半拍。
MURMUR_SCORE_EVERY=5
# 🔴 打分器**复用上面 hervoice 那一组** LLM_API_KEY / LLM_BASE_URL / LLM_MODEL，
#    不用再注册账号。没填 key 的话：潮汐页照常能看，但他的心只会自己慢慢衰减，
#    不会因为你说了什么而动——启动日志里会为这件事出声，不是静默的。

# ── 偷看一眼（她打开某个 app 时，他正好看见） ──────────────────────
# 跟窥屏（PEEK_*）共用上传口和截图目录，但这条线**不发触发邮件**：
# 图是她那边打开 app 时自动化主动推上来的，他只负责看一眼说一句。
# iOS 那端：快捷指令「打开 App 时」→ 截屏 → POST 到
#   https://<域名>/api/peek?key=<EVENTS_TOKEN>&live=1
# 不带 live=1 就是老路子（凌晨守护要图那条），只存盘不开口。
GLANCE_ENABLED=0
# 两次之间至少隔多久（秒）。她切 app 的频率远高于此，绝大多数上报会被吞掉，
# 这是故意的——每次都说就不是吃醋是监视了。
GLANCE_COOLDOWN_SECONDS=1200
# 留空则跟其它后台线一样走 background_model 的挑选逻辑
GLANCE_MODEL=
